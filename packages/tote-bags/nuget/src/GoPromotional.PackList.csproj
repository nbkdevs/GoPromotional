<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>GoPromotional</RootNamespace>
    <PackageId>GoPromotional.PackList</PackageId>
    <Version>1.0.1</Version>
    <Authors>GoPromotional</Authors>
    <Company>GoPromotional</Company>
    <Description>Packing checklists with templates, per-night quantities and a Markdown format.</Description>
    <PackageTags>packing-list checklist travel markdown gopromotional</PackageTags>
    <PackageProjectUrl>https://www.gopromotional.co.uk/branded-products/tote-bags</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nbkdevs/GoPromotional</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
