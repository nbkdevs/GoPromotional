{
  "manifest_version": 3,
  "name": "Pack Quick",
  "version": "1.1.1",
  "description": "Manage packing lists in your toolbar: multiple lists, templates, filters, and copy-to-clipboard.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pack Quick",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "96": "icons/icon96.png",
      "114": "icons/icon114.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "114": "icons/icon114.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pack-quick@gopromotional.co.uk",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
