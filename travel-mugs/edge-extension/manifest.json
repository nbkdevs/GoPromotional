{
  "manifest_version": 3,
  "name": "Mug Tap",
  "version": "1.1.1",
  "description": "Track reusable vs disposable cup use, see weekly rates and streaks, and copy a short habit summary.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mug Tap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "96": "icons/icon96.png",
      "114": "icons/icon114.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "114": "icons/icon114.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
